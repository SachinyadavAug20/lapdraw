{
  "manifest_version": 3,
  "name": "LapDraw — Trackpad Drawing",
  "version": "0.5.0",
  "description": "Draw on any website with your laptop trackpad, or open an infinite canvas in a new tab. Built for people without a pen or mouse.",
  "permissions": ["activeTab", "storage", "tabs"],
  "action": {
    "default_title": "LapDraw",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["shared/intelligence.js", "content/content.js"],
      "css": ["content/overlay.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "commands": {
    "toggle-draw": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Toggle LapDraw drawing mode on the current page"
    },
    "toggle-eraser": {
      "suggested_key": { "default": "Alt+Shift+E" },
      "description": "Switch between pen and eraser on the current page"
    },
    "undo-stroke": {
      "suggested_key": { "default": "Alt+Shift+Z" },
      "description": "Undo the last stroke on the current page"
    },
    "open-canvas": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Open the LapDraw infinite canvas"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
